{
  "permissions": {
    "allow": [
      "Bash(chmod +x:*)",
      "Bash(npx --version)",
      "mcp__playwright_*",
      "mcp__playwright_headed__*",
      "mcp__plugin_AI-Driven-UI-Specification_playwright_headed__*",
      "mcp__figma__*",
      "mcp__plugin_AI-Driven-UI-Specification_figma__*",
      "mcp__pencil__*",
      "Bash(pkill -f \"mcp-chrome\")",
      "mcp__claude_ai_Figma__get_design_context",
      "mcp__claude_ai_Figma__get_screenshot",
      "Bash(grep -E \"\\\\.\\(md|json|yml|yaml|sh\\)$\")"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright_headed",
    "figma"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-on-execution-dispatch.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-on-spec-created.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-on-tests-generated.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-on-report-written.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-on-user-prompt.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "test-execution",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-verify-report.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-verify-report.sh\""
          }
        ]
      }
    ]
  }
}
